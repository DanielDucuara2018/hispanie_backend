# Hispanie Backend - Environment Variables Template
# Copy this file to .env and fill in your values

# Database Configuration
HISPANIE_DB_NAME_ENV=hispanie
HISPANIE_DB_HOST_ENV=postgres
HISPANIE_DB_PORT_ENV=5432
HISPANIE_DB_USER_ENV=postgres
HISPANIE_DB_PASSWORD_ENV=your_password_here
HISPANIE_DB_REF_TABLE_ENV=account

# JWT Configuration
HISPANIE_JWT_SECRET_KEY_ENV=your_jwt_secret_key_here
HISPANIE_JWT_ALGORITHM_ENV=HS256
HISPANIE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES_ENV=30

# Email Configuration
HISPANIE_EMAIL_SECRET_KEY_ENV=your_email_secret_key_here
HISPANIE_EMAIL_SECURITY_PASSWORD_SALT_ENV=your_security_password_salt_here
HISPANIE_EMAIL_FRONTEND_URL_ENV=http://localhost:3202
HISPANIE_EMAIL_USERNAME_ENV=your_email@example.com
HISPANIE_EMAIL_PASSWORD_ENV=your_email_password_here
HISPANIE_EMAIL_ADDRESS_ENV=your_email@example.com
HISPANIE_EMAIL_PORT_ENV=587
HISPANIE_EMAIL_NAME_ENV=Your App Name
HISPANIE_EMAIL_SERVER_ENV=smtp.example.com
HISPANIE_EMAIL_START_TLS_ENV=1
HISPANIE_EMAIL_SSL_TLS_ENV=0
HISPANIE_EMAIL_CREDENTIALS_ENV=1
HISPANIE_EMAIL_VALIDATE_CERTS_ENV=1

# AWS/S3 Configuration
HISPANIE_AWS_BUCKET_NAME_ENV=your-bucket-name
HISPANIE_AWS_ACCESS_KEY_ENV=your-aws-access-key
HISPANIE_AWS_SECRET_KEY_ENV=your-aws-secret-key
HISPANIE_AWS_REGION_ENV=eu-west-3

# Default Admin Account
HISPANIE_ACCOUNT_USERNAME_ENV=admin_username
HISPANIE_ACCOUNT_PASSWORD_ENV=your_admin_password_here
HISPANIE_ACCOUNT_EMAIL_ENV=admin@example.com
HISPANIE_ACCOUNT_PHONE_ENV=+1234567890
HISPANIE_ACCOUNT_DESCRIPTION_ENV=Admin account description
